{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projeto-viagem-sae",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRIP_STORE",
        "class_name": "TripStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TripStore"]
    }
  ]
}
